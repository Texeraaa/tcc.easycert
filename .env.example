# .env.example — variáveis de ambiente do easycert
# Copie para .env.local e preencha os valores reais (nunca commite .env.local).
#
# DATABASE_URL_MIGRATE: lido apenas por `pnpm db:migrate` (prisma migrate dev/deploy).
#   Usa role easycert_owner (dono do schema, cria tabelas e enums).
#
# DATABASE_URL: lido pelo PrismaService em runtime (Round 2 configura o ConfigService).
#   Usa role easycert_app (apenas SELECT, INSERT, UPDATE, DELETE — sem DDL).
#   audit_log: easycert_app tem apenas INSERT e SELECT (invariante RF-26).

# ---------------------------------------------------------------------------
# Banco de dados — dois roles (ver infra/postgres-init/01-roles.sql)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://easycert_app:app_password@localhost:5432/easycert
DATABASE_URL_MIGRATE=postgresql://easycert_owner:owner_password@localhost:5432/easycert

# ---------------------------------------------------------------------------
# Backend (NestJS)
# ---------------------------------------------------------------------------
PORT=3333
JWT_SECRET=substitua-por-secret-aleatorio-de-32-bytes-ou-mais
CSRF_SECRET=substitua-por-secret-aleatorio-de-32-bytes-ou-mais
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# MinIO (configurado em T7a — Round 3)
# ---------------------------------------------------------------------------
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=easycert

# ---------------------------------------------------------------------------
# Mailtrap (e-mail transacional em dev)
# ---------------------------------------------------------------------------
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USER=substitua-pelo-user-do-mailtrap
# MAILTRAP_PASSWORD=substitua-pela-senha-do-mailtrap

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3333
